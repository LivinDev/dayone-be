// Day01 backend data model — source of truth is ../dayone-backend.md §5.
// Copied in verbatim; don't redesign ad hoc, see that doc for the reasoning.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  MANAGER
  ADMIN
}

model User {
  id                   String              @id @default(cuid())
  email                String              @unique
  password             String // bcrypt hash
  phone                String?
  name                 String?
  role                 Role                @default(CUSTOMER)
  passwordResetToken   String?             @unique
  passwordResetExpires DateTime?
  createdAt            DateTime            @default(now())
  orders               Order[]
  nfcTags              NfcTag[]
  addresses            Address[]
  reviews              Review[]
  garmentTagRequests   GarmentTagRequest[]
}

// Saved shipping addresses — a user can have several, one marked default.
// Not on the original spec's model list; added for Account Home's
// "Shipping & Addresses" tab. `Order.shippingAddress` stays a JSON snapshot
// taken at checkout time (so editing/deleting a saved address here never
// rewrites a past order's address) — this table is only the reusable book.
model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  label     String? // e.g. "Home", "Work" — optional, user-chosen
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String // feeds future GST CGST+SGST vs IGST logic in the Orders module
  pincode   String
  country   String   @default("India")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Admin-manageable — not a fixed enum. Created/renamed/deleted from the
// dashboard (`src/categories/`); deleting one just detaches it from any
// products via the implicit m2m join table's cascade, no block/guard needed
// (unlike ProductVariant's ordered-count guard, which only applies to a
// required single FK — category membership is optional/many-valued).
model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  description  String
  priceInPaise Int // store money as integer paise, never float — base/fallback selling price
  mrpInPaise   Int? // optional "was" price — discount % is computed live from this, never stored
  gsm          Int? // e.g. 240
  fit          String? // e.g. "Oversized Drop Shoulder"
  images       String[] // max 5, enforced in the DTO — shared/default gallery
  categories   Category[] // occasion/gender tags, a product can have multiple
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  orderItems   OrderItem[]
  variants     ProductVariant[]
  reviews      Review[]
}

// Purchase-gated reviews, added 2026-09-08. Eligibility is checked at
// creation time against real order history — has a non-cancelled Order
// containing this product, NOT "delivered" (nothing in this system ever
// marks an order DELIVERED yet, no fulfillment-tracking UI exists — gating
// on delivery would make reviews impossible for anyone, ever). `orderId`
// records which qualifying order proved eligibility, for audit purposes;
// it isn't re-checked on every read.
model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  rating    Int // 1-5
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId]) // one review per user per product; edit, don't duplicate
}

// Color+size variants, added 2026-09-08. A product with zero variants is
// "legacy" — the storefront falls back to static placeholder sizing until
// real variants (with real stock) are added for it. Never auto-backfilled
// with invented stock numbers for existing products; that's the founder's
// own inventory data to enter, not something to fabricate.
model ProductVariant {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  color         String? // optional — not every product needs a color axis
  size          String
  sku           String      @unique
  priceInPaise  Int? // optional override; falls back to Product.priceInPaise if null
  mrpInPaise    Int? // optional override; falls back to Product.mrpInPaise if null
  stockQuantity Int         @default(0)
  images        String[] // max 5, enforced in the DTO — empty = falls back to Product.images
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]

  // Coarse DB-level guard. NULL colors don't collide under Postgres unique
  // semantics (NULL != NULL), so the service layer also checks for
  // productId+size+color duplicates explicitly — don't rely on this alone.
  @@unique([productId, color, size])
}

model Order {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  status           OrderStatus   @default(PENDING)
  items            OrderItem[]
  shippingAddress  Json
  totalInPaise     Int
  gstAmountInPaise Int
  paymentGatewayId String?
  paymentStatus    PaymentStatus @default(PENDING)
  invoice          Invoice?
  createdAt        DateTime      @default(now())
  reviews          Review[]
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// One row = one physical shirt = at most one NfcTag. No `quantity` field:
// every unit is individually NFC-serialized, so "buy 2" means 2 OrderItem
// rows, not one row with quantity 2 — there'd be nowhere to hang the second tag.
model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id])
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  priceInPaise Int // snapshot price at time of order
  size         String // snapshotted from the variant at order time (or legacy free text)
  color        String? // snapshotted from the variant at order time
  // Nullable on purpose: orders placed before variants existed (real founder
  // order from 2026-09-07, size-only) have no variant to point at — never
  // backfilled with an invented one. Every new order requires variantId.
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  nfcTag       NfcTag?
}

model Invoice {
  id            String   @id @default(cuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id])
  invoiceNumber String   @unique // sequential per financial year, e.g. DAY01/2026/0001
  cgstInPaise   Int
  sgstInPaise   Int
  igstInPaise   Int
  hsnCode       String
  pdfUrl        String?
  createdAt     DateTime @default(now())
}

model NfcTag {
  id                  String             @id @default(cuid())
  code                String             @unique // short code written on the physical tag
  status              TagStatus          @default(UNCLAIMED)
  orderItemId         String?            @unique // the one physical shirt this tag is fused to
  orderItem           OrderItem?         @relation(fields: [orderItemId], references: [id])
  // A tag fused to a garment the customer already owned (not bought from
  // Day01) via the retrofit "tag my own garment" service — mutually
  // exclusive with orderItemId, same nullable-FK shape. Set once staff mark
  // a GarmentTagRequest TAG_INSTALLED; ownerId is set directly at the same
  // time (the requester is already known — no separate claim step needed).
  tagInstallRequestId String?            @unique
  tagInstallRequest   GarmentTagRequest? @relation(fields: [tagInstallRequestId], references: [id])
  ownerId             String?
  owner               User?              @relation(fields: [ownerId], references: [id])
  destination         Destination?
  // Which kind of destination this claimed tag currently resolves to — null
  // until the owner picks one (right after claiming). LINK keeps using
  // `destination`; STORY means GET /t/:code sends taps to /story/:code
  // instead, and `destination` stays unused/null.
  destinationKind     DestinationKind?
  // Only meaningful once destinationKind = STORY — which of the fixed
  // preset color themes the owner's story page renders in.
  storyTheme          StoryTheme?
  timelineEntries     TimelineEntry[]
  createdAt           DateTime           @default(now())
}

enum TagStatus {
  UNCLAIMED // manufactured, not linked to a sale
  ASSIGNED // linked to an order item (one physical shirt), not yet claimed
  CLAIMED // buyer verified ownership, can edit destination
}

enum DestinationKind {
  LINK
  STORY
}

// Fixed preset palette an owner picks for their Story page — not an
// arbitrary color picker (deliberately small/curated, matches this
// project's stance against building infrastructure ahead of actual need).
enum StoryTheme {
  SUNSET_BLOOM
  OCEAN_TIDE
  FOREST_MOSS
  MONO_ARCHIVE
}

model Destination {
  id        String   @id @default(cuid())
  tagId     String   @unique
  tag       NfcTag   @relation(fields: [tagId], references: [id])
  url       String
  updatedAt DateTime @updatedAt
}

// "Tag my own garment" — a retrofit service, separate from the main
// purchase flow: a customer sends in a garment they already own (not
// bought from Day01) to have an NFC tag physically fused into it. Added
// 2026-09-17, not in the original spec. No Order/OrderItem/payment-gateway
// involvement — this isn't a Product purchase, so it gets its own model
// and its own fixed cash-on-pickup fee rather than being forced through
// the Orders module. Pickup logistics are manual (founder arranges it
// directly with the customer) — no courier API integration, matching this
// project's no-dev-budget, speed-over-scale stance everywhere else.
model GarmentTagRequest {
  id              String                  @id @default(cuid())
  userId          String
  user            User                    @relation(fields: [userId], references: [id])
  garmentPhotoUrl String
  garmentNote     String? // optional free text, e.g. "black oversized hoodie"
  // Where on the photo the tag should go — normalized 0-1 fractions of the
  // image's width/height, not pixels, so it renders correctly regardless
  // of what size the photo is actually displayed at (composer vs admin
  // detail vs any future thumbnail).
  markerX         Float
  markerY         Float
  contactName     String
  contactPhone    String
  contactEmail    String
  pickupLine1     String
  pickupLine2     String?
  pickupCity      String
  pickupState     String
  pickupPincode   String
  // Only set if the customer used "Use My Current Location" — lets the
  // admin queue offer a precise "Open in Maps" link instead of just a
  // text-address search. Null is common and fine; never blocks submission.
  pickupLat       Float?
  pickupLng       Float?
  // Fixed at creation time from a server-side constant, never trusted from
  // the client — same "money is never client-supplied" rule Orders already
  // follows. Cash on pickup/drop-off, no payment gateway involved.
  feeInPaise      Int
  status          GarmentTagRequestStatus @default(SUBMITTED)
  // Internal staff notes (e.g. "customer prefers evening pickup") — never
  // shown to the customer, same spirit as this codebase's other admin-only
  // free-text fields.
  staffNotes      String?
  nfcTag          NfcTag?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
}

enum GarmentTagRequestStatus {
  SUBMITTED // just submitted, awaiting staff to arrange pickup
  PICKUP_SCHEDULED // staff have contacted the customer and arranged a pickup
  RECEIVED // garment physically received by Day01
  TAG_INSTALLED // tag fused in — this is the status transition that links a real NfcTag and sets ownership
  RETURNED // garment shipped/handed back to the customer
  CANCELLED
}

// The Story feature's content — one entry per dated "moment" an owner logs
// against their garment. Was scaffolded V2-only/unused; now built for real
// (2026-09-16) as the second destinationKind alongside a plain link.
model TimelineEntry {
  id        String            @id @default(cuid())
  tagId     String
  tag       NfcTag            @relation(fields: [tagId], references: [id])
  location  String? // free text (e.g. "Goa, India") — no map/coordinates in v1
  occasion  EntryOccasion? // per-moment tag (Birthday, Beach Day, ...) — optional, distinct from NfcTag.storyTheme (the whole page's one-time color theme)
  entryDate DateTime          @default(now())
  status    EntryStatus       @default(APPROVED) // auto-published per founder's call — field kept so moderation can be turned on later via a default flip, not a migration
  createdAt DateTime          @default(now())
  sections  TimelineSection[]
}

// A moment within a day — a day (TimelineEntry) can hold several, each its
// own small block of captioned images. Added 2026-09-16 so a day can be
// more than one flat gallery+caption (e.g. "Lunch" and "Evening walk" as
// two separate sections on the same birthday).
model TimelineSection {
  id        String          @id @default(cuid())
  entryId   String
  entry     TimelineEntry   @relation(fields: [entryId], references: [id])
  caption   String? // short label for this section, distinct from each image's own caption below
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  images    TimelineImage[]
}

model TimelineImage {
  id        String          @id @default(cuid())
  sectionId String
  section   TimelineSection @relation(fields: [sectionId], references: [id])
  url       String
  caption   String? // per-image caption — the actual new capability this migration adds
  order     Int             @default(0)
}

// Per-moment occasion tag, chosen when adding an entry — a fixed, curated
// set (matches this project's stance against open-ended taxonomy for
// something this small), each with its own icon+color in the frontend.
enum EntryOccasion {
  SUNSET
  BEACH_DAY
  TREKKING
  BIRTHDAY
  AMUSEMENT_PARK
  DATE_NIGHT
  RESTAURANT
}

enum EntryStatus {
  PENDING
  APPROVED
  REJECTED
}
