# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/day01_db?connection_limit=10"

# API port (storefront dev server uses 3000)
PORT=4000
FRONTEND_ORIGIN="http://localhost:3000"
# Optional, comma-separated
CORS_EXTRA_ORIGINS=""

# Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Used once by `pnpm run seed` to create the first ADMIN. Remove after seeding.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-me"

# S3 (product/story images, invoice PDFs)
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="your-bucket-name"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Seller details printed on GST invoices
SELLER_LEGAL_NAME=""
SELLER_GSTIN=""
SELLER_ADDRESS_LINE1=""
SELLER_ADDRESS_LINE2=""
SELLER_CITY=""
SELLER_STATE="Karnataka"
SELLER_STATE_CODE="29"
SELLER_PINCODE=""
SELLER_PAN=""
